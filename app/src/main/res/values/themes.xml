<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShortsShield" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="HeroEyebrow" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HeroTitle" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="HeroBody" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SectionTitle" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CardTitle" parent="android:style/TextAppearance.Material.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="BodyText" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="BodyTextSmall" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="HelperText" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SummaryText" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:lineSpacingExtra">6dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ValueText" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="StatusChip" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="RuleSwitch" parent="android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:minHeight">56dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/button_primary_background</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="SecondaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/button_secondary_background</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="TertiaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/button_tertiary_background</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="DangerButton" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/button_danger_background</item>
        <item name="android:textColor">@color/danger_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="CardDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="android:background">@color/line</item>
    </style>
</resources>
