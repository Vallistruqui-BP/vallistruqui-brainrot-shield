<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShortsShield" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/header</item>
        <item name="android:navigationBarColor">@color/header</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="HeroEyebrow" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="HeroTitle" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">27sp</item>
    </style>

    <style name="HeroBody" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/header_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SectionTitle" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">23sp</item>
    </style>

    <style name="CardTitle" parent="android:style/TextAppearance.Material.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="BodyText" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="BodyTextSmall" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="HelperText" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SummaryText" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">7dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ValueText" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="StatusChip" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="RuleSwitch" parent="android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="SecondaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:backgroundTint">@color/secondary_button</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="TertiaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:backgroundTint">@color/tertiary_button</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>
